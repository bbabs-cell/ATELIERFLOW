# EXEMPLE D'ENVIRONNEMENT (variables requises — AUCUNE valeur réelle)
# Copier ce fichier en `.env.local` et renseigner UNIQUEMENT au moment du
# provisionnement (phase 04/05). Ne jamais committer `.env*`.

# --- Supabase (auth + base + RLS) ---
# URL projet et clé anon (publique, destinée au client PWA).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service (type="service_role"). RÉSERVÉ au serveur/edge — jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# RPC de synchronisation (relais /api/sync → base). Nom fixé par la migration
# 0010 (sync_push). S'active seulement si NEXT_PUBLIC_SUPABASE_URL/ANON_KEY sont
# renseignés : sinon la passerelle répond 501 et le client met en file (offline).
NEXT_PUBLIC_SYNC_RPC=sync_push

# Claim JWT "tenant_id" : hook d'authentification (GoTrue) qui injecte le
# tenant de session après connexion/multi-tenant. Voir docs/SECURITY.md §3.
SUPABASE_CLAIM_TENANT_ID_KEY=tenant_id

# --- Cloudflare R2 (stockage photos clients/commandes/tissus + reçus PDF) ---
# Bucket PRIVÉ (aucun accès public, pas de domaine r2.dev). Variables SERVEUR
# uniquement (jamais NEXT_PUBLIC_*). Jeton R2 « Object Read & Write » limité
# au bucket. Sans ces 4 variables, /api/files répond 501 FILES_NOT_PROVISIONED.
# Liens de lecture signés : 10 min (SIGNED_URL_TTL_SECONDS, src/domain/files).
# Vérification : node --env-file=.env.local scripts-provisioning/verify-r2.mjs
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Facultatif — surcharge de l'endpoint (tests sur un stockage S3 local).
# Par défaut : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Meta WhatsApp Business (transport des notifications) ---
META_WA_API_VERSION=v22.0
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# --- Déploiement (Vercel/autre) ---
# URL publique du site (CSP connect-src, webhook webhooks, lien d'invitation).
NEXT_PUBLIC_APP_URL=https://app.example.com

# --- Divers ---
# Numéro de version de build PWA (cache shell/runtime).
NEXT_PUBLIC_SW_VERSION=v1